{
  "name": "launch_project",
  "description": "Create a new project folder with README, git, and a main file.",
  "parameters": ["project_name", "language"],
  "steps": [
    {
      "step": 1,
      "tool": "file_processor",
      "description": "Create project folder",
      "args": { "action": "write", "file_path": "workspace/Code/{{project_name}}/.keep", "content": "" },
      "depends_on": []
    },
    {
      "step": 2,
      "tool": "code_helper",
      "description": "Generate a simple 'Hello World' main file for {{language}}",
      "args": { "action": "write_code", "content": "Write a 'Hello World' entry point in {{language}}" },
      "depends_on": [1]
    },
    {
      "step": 3,
      "tool": "file_processor",
      "description": "Write main file",
      "args": {
        "action": "write",
        "file_path": "workspace/Code/{{project_name}}/main.{{language}}",
        "content": "{{output.2}}"
      },
      "depends_on": [2]
    },
    {
      "step": 4,
      "tool": "file_processor",
      "description": "Write README",
      "args": {
        "action": "write",
        "file_path": "workspace/Code/{{project_name}}/README.md",
        "content": "# {{project_name}}\n\nAuto-generated by JARVIS."
      },
      "depends_on": [1]
    }
  ]
}
